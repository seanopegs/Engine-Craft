[node name="HSeparator" type="HSeparator" parent="CenterContainer/Panel/ScrollContainer/Margin/VBox"]
layout_mode = 2

[node name="Section1Title" type="Label" parent="CenterContainer/Panel/ScrollContainer/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.9, 1, 1)
theme_override_font_sizes/font_size = 18
text = "1. Karakter Buta (Blind / Echo - Cyan)"

[node name="Section1Desc" type="Label" parent="CenterContainer/Panel/ScrollContainer/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 0.95, 1)
theme_override_font_sizes/font_size = 14
text = "• Layar dalam kegelapan pekat.
• Tekan [SPACE] atau [E] untuk memancarkan gelombang Sonar (Echolocation).
• Sonar menerangi dinding, pintu suara [S], dan mendeteksi detak jantung Monster [M] menembus dinding!
• Kunci Suara [S] dan Pintu Akustik [s] hanya bisa dideteksi dengan sonar."
autowrap_mode = 2

[node name="Section2Title" type="Label" parent="CenterContainer/Panel/ScrollContainer/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.2, 1)
theme_override_font_sizes/font_size = 18
text = "2. Karakter Tuli (Deaf / Sight - Kuning)"

[node name="Section2Desc" type="Label" parent="CenterContainer/Panel/ScrollContainer/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 0.95, 1)
theme_override_font_sizes/font_size = 14
text = "• Layar terang penuh, bisa melihat seluruh labirin, warna pintu, dan Laser Trap [L].
• Tuli: Tidak bisa mendengar suara monster di balik tembok (waspada saat berbelok di tikungan!).
• Bisa mengambil Kunci Warna [R/K] dan membuka Pintu Warna [r/k]."
autowrap_mode = 2

[node name="Section3Title" type="Label" parent="CenterContainer/Panel/ScrollContainer/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.5, 1, 1)
theme_override_font_sizes/font_size = 18
text = "3. Kontrol & Mekanik Khusus"

[node name="Section3Desc" type="Label" parent="CenterContainer/Panel/ScrollContainer/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 0.95, 1)
theme_override_font_sizes/font_size = 14
text = "• [WASD / Panah]: Bergerak
• [TAB / Q]: Ganti Karakter (Cooldown 2.5s)
• [F]: Toggle Mode Follow (Partner mengikuti Anda atau diam di tempat untuk menekan Pressure Plate)
• [ESC]: Pause Menu
• [R]: Restart Level Cepat"
autowrap_mode = 2

[node name="Section4Title" type="Label" parent="CenterContainer/Panel/ScrollContainer/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 1, 0.5, 1)
theme_override_font_sizes/font_size = 18
text = "4. Cara Mengedit Level Sendiri (.txt)"

[node name="Section4Desc" type="Label" parent="CenterContainer/Panel/ScrollContainer/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 0.95, 1)
theme_override_font_sizes/font_size = 14
text = "Buka folder 'levels/' di file explorer lalu buka file level_1.txt s/d level_5.txt dengan Notepad!
Simbol: # (Tembok), . (Lantai), P (Spawn), E (Exit), M (Monster), R (Kunci Merah), r (Pintu Merah), S (Kunci Suara), s (Pintu Suara), L (Laser), O (Tombol Tekan), G (Gerbang)."
autowrap_mode = 2

